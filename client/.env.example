# =============================================================
# QuizSphere - client environment template
# Copy to `client/.env`. Only VITE_* variables reach the browser.
# NEVER put a secret in this file.
# =============================================================

# Base URL for the REST API. Keep the relative default so the Vite dev
# proxy (and production reverse proxy) forwards /api to the Express server.
VITE_API_BASE_URL=/api

# Shown in the navbar/footer and page titles.
VITE_APP_NAME=QuizSphere

# Public support/contact address used by the Contact page. Replace with a
# real address before publishing (clearly a placeholder until then).
VITE_CONTACT_EMAIL=support@quizsphere.example
