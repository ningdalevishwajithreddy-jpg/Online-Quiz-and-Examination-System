{
  "name": "quizsphere",
  "version": "1.0.0",
  "private": true,
  "description": "QuizSphere - online quiz and examination management system (MERN)",
  "license": "MIT",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server",
    "lint": "npm run lint --workspace server && npm run lint --workspace client",
    "lint:fix": "npm run lint:fix --workspace server && npm run lint:fix --workspace client"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
